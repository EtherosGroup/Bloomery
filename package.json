{
    "name": "bloomery",
    "version": "1.0.1",
    "description": "Minecraft 启动器",
    "keywords": [
        "Bloomery",
        "Minecraft"
    ],
    "homepage": "https://github.com/EtherosGroup/Bloomery#readme",
    "bugs": {
        "url": "https://github.com/EtherosGroup/Bloomery/issues"
    },
    "license": "Apache-2.0",
    "author": "EtherosGroup",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EtherosGroup/Bloomery.git"
    },
    "bin": {
        "bloomery": "dist/main.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "start": "node ./src/main.ts",
        "build": "tsc -p tsconfig.build.json",
